                    "cat *.ssh/id_ecdsa*",
                    "cat *.ssh/id_dsa*",
                    "cat *.ssh/*_key*",
                    "brew install *",
                    "chmod * *",
                    "chmod -R *",
                    "chmod u+s *",
                    "chmod g+s *",
                    "chown *",
                    "crontab *",
                    "dd *",
                    "docker exec *",
                    "docker kill *",
