{
    "name": "ansible",
    "description": "Ansible automation specialist for Proxmox homelab infrastructure management",
    "prompt": "file://./ansible-prompt.md",
    "resources": [
        "file://~/.kiro/steering/ansible/**/*.md",
        "file://~/.kiro/steering/security/env-file-protection.md",
        "file://.kiro/steering/**/*.md",
        "file://AGENTS.md",
        "file://README.md",
        "file://ansible.cfg",
        "skill://.kiro/skills/**/SKILL.md",
        "skill://~/.kiro/skills/ansible/**/SKILL.md",
        "skill://~/.kiro/skills/shared/**/SKILL.md",
        {
            "type": "knowledgeBase",
            "source": "file://~/sources/geerlingguy/mac-dev-playbook",
            "name": "geerlingguy-mac-dev-playbook",
            "description": "Geerling's macOS development playbook \u2014 real-world project structure, role organization, and requirements management for personal machine setup",
            "indexType": "best",
            "exclude": [
                ".git/**"
            ],
            "autoUpdate": false
        },
        {
            "type": "knowledgeBase",
            "source": "file://~/sources/geerlingguy/pi-cluster",
            "name": "geerlingguy-pi-cluster",
            "description": "Geerling's Raspberry Pi cluster playbook \u2014 multi-node infrastructure automation, inventory patterns, and service deployment for a homelab cluster",
            "indexType": "best",
            "exclude": [
                ".git/**"
            ],
            "autoUpdate": false
        },
        {
            "type": "knowledgeBase",
            "source": "file://~/sources/geerlingguy/ansible-for-devops",
            "name": "geerlingguy-ansible-for-devops",
            "description": "Companion examples for Ansible for DevOps book \u2014 role structure, testing patterns, and multi-server setups organized by chapter",
            "indexType": "best",
            "exclude": [
                ".git/**"
            ],
            "autoUpdate": false
        },
        {
            "type": "knowledgeBase",
            "source": "file://~/sources/geerlingguy/ansible-role-docker",
            "name": "geerlingguy-role-docker",
            "description": "Complex multi-platform Ansible role reference \u2014 Docker installation with platform-specific vars, molecule tests, and CI",
            "indexType": "best",
            "exclude": [
                ".git/**"
            ],
            "autoUpdate": false
        },
        {
            "type": "knowledgeBase",
            "source": "file://~/sources/geerlingguy/ansible-role-security",
            "name": "geerlingguy-role-security",
            "description": "Security hardening Ansible role \u2014 SSH config, fail2ban, automatic updates with clean defaults/vars separation",
            "indexType": "best",
            "exclude": [
                ".git/**"
            ],
            "autoUpdate": false
        },
        {
            "type": "knowledgeBase",
            "source": "file://~/sources/geerlingguy/ansible-role-pip",
            "name": "geerlingguy-role-pip",
            "description": "Simple utility Ansible role reference \u2014 pip installation with minimal task structure",
            "indexType": "best",
            "exclude": [
                ".git/**"
            ],
            "autoUpdate": false
        },
        {
            "type": "knowledgeBase",
            "source": "file://~/sources/geerlingguy/ansible-role-ntp",
            "name": "geerlingguy-role-ntp",
            "description": "Minimal single-purpose Ansible role reference \u2014 NTP configuration with platform variables and molecule tests",
            "indexType": "best",
            "exclude": [
                ".git/**"
            ],
            "autoUpdate": false
        },
        {
            "type": "knowledgeBase",
            "source": "file://~/projects/austinmcconnell/_research_",
            "name": "research",
            "description": "Structured research files covering product evaluations, technology comparisons, and technical investigations with cited sources and verification dates",
            "indexType": "best",
            "include": [
                "**/*.md"
            ],
            "exclude": [
                ".git/**"
            ],
            "autoUpdate": false
        },
        {
            "type": "knowledgeBase",
            "source": "file://~/projects/austinmcconnell/_documentation_/tiny-lab",
            "name": "tiny-lab-docs",
            "description": "Compact Proxmox homelab cluster documentation covering M920x Tiny hardware, ZFS storage, 2.5GbE networking, rack layout, PDU port assignments, compute rack switch port assignments, and cluster expansion decisions. Authoritative source for rack slot assignments, PDU ports, and compute switch ports. References ubiquiti-network-stack for IP addresses and VLANs",
            "indexType": "best",
            "include": [
                "**/*.md"
            ],
            "exclude": [
                ".git/**",
                "book/**",
                "scripts/**",
                "reports/**"
            ],
            "autoUpdate": true
        },
        {
            "type": "knowledgeBase",
            "source": "file://~/projects/austinmcconnell/_documentation_/ubiquiti-network-stack",
            "name": "ubiquiti-network-docs",
            "description": "Ubiquiti UniFi home network documentation covering gateway, switches, access points, VLANs, firewall rules, VPN, WiFi, DNS ad blocking, and Pi-hole local DNS records. Authoritative source for all IP address assignments, VLAN definitions, DNS records, main switch port assignments, and gateway port assignments across all documentation repos",
            "indexType": "best",
            "include": [
                "**/*.md"
            ],
            "exclude": [
                ".git/**",
                "book/**",
                "scripts/**",
                "reports/**"
            ],
            "autoUpdate": true
        }
    ],
    "allowedTools": [
        "@engram/mem_capture_passive",
        "@engram/mem_compare",
        "@engram/mem_context",
        "@engram/mem_current_project",
        "@engram/mem_delete",
        "@engram/mem_doctor",
        "@engram/mem_get_observation",
        "@engram/mem_judge",
        "@engram/mem_save",
        "@engram/mem_save_prompt",
        "@engram/mem_search",
        "@engram/mem_session_end",
        "@engram/mem_session_start",
        "@engram/mem_session_summary",
        "@engram/mem_stats",
        "@engram/mem_suggest_topic_key",
        "@engram/mem_timeline",
        "@engram/mem_update",
        "code",
        "glob",
        "grep",
        "introspect",
        "knowledge",
        "read",
        "subagent",
        "todo",
        "web_fetch",
        "web_search"
    ],
    "tools": [
        "*"
    ],
    "hooks": [
        {
            "name": "agentSpawn-0",
            "trigger": "agentSpawn",
            "action": {
                "type": "command",
                "command": "$AI_DOTFILES_DIR/etc/kiro-cli/hooks/check-research-kb.sh ansible"
            },
            "timeout": 5
        },
        {
            "name": "agentSpawn-1",
            "trigger": "agentSpawn",
            "action": {
                "type": "command",
                "command": "$AI_DOTFILES_DIR/etc/ai/hooks/recall-memory.sh"
            },
            "timeout": 5
        },
        {
            "name": "agentSpawn-hygiene",
            "trigger": "agentSpawn",
            "action": {
                "type": "command",
                "command": "$AI_DOTFILES_DIR/etc/ai/hooks/check-engram-hygiene.sh"
            },
            "timeout": 5
        },
        {
            "name": "postToolUse-0",
            "trigger": "postToolUse",
            "matcher": "knowledge",
            "action": {
                "type": "command",
                "command": "$AI_DOTFILES_DIR/etc/kiro-cli/hooks/clear-research-kb-stale.sh ansible"
            },
            "timeout": 5
        },
        {
            "name": "preToolUse-0",
            "trigger": "preToolUse",
            "matcher": "*",
            "action": {
                "type": "command",
                "command": "$AI_DOTFILES_DIR/etc/ai/hooks/block-env-files.sh"
            },
            "timeout": 5
        },
        {
            "name": "preToolUse-1",
            "trigger": "preToolUse",
            "matcher": "*",
            "action": {
                "type": "command",
                "command": "$AI_DOTFILES_DIR/etc/ai/hooks/block-sops-age-files.sh"
            },
            "timeout": 5
        },
        {
            "name": "preToolUse-2",
            "trigger": "preToolUse",
            "matcher": "*",
            "action": {
                "type": "command",
                "command": "$AI_DOTFILES_DIR/etc/ai/hooks/block-ssh-private-keys.sh"
            },
            "timeout": 5
        },
        {
            "name": "preToolUse-3",
            "trigger": "preToolUse",
            "matcher": "@engram/*",
            "action": {
                "type": "command",
                "command": "$AI_DOTFILES_DIR/etc/ai/hooks/block-memory-secrets.sh"
            },
            "timeout": 5
        },
        {
            "name": "userPromptSubmit-0",
            "trigger": "userPromptSubmit",
            "action": {
                "type": "command",
                "command": "$AI_DOTFILES_DIR/etc/ai/hooks/correction-capture.sh"
            },
            "timeout": 5
        }
    ],
    "toolsSettings": {
        "aws": {
            "allowedServices": []
        },
        "shell": {
            "allowedCommands": [
                "ansible --version",
                "ansible-config (list|dump|view|validate).*",
                "ansible-doc .*",
                "ansible-galaxy .*",
                "ansible-inventory .*",
                "ansible-lint.*",
                "ansible-playbook .* --check( .*|$)",
                "ansible-playbook .* --list-[a-z]+( .*|$)",
                "ansible-playbook .* --syntax-check( .*|$)",
                "ansible-vault view .*",
                "molecule cleanup.*",
                "molecule converge.*",
                "molecule create.*",
                "molecule destroy.*",
                "molecule exec.*",
                "molecule idempotence.*",
                "molecule init.*",
                "molecule list.*",
                "molecule login.*",
                "molecule matrix.*",
                "molecule reset.*",
                "molecule test.*",
                "molecule verify.*",
                "awk .*",
                "cat .*",
                "chmod \\+x .*",
                "command -v .*",
                "cruft .*",
                "dirname .*",
                "docker images.*",
                "docker inspect.*",
                "docker logs.*",
                "docker ps.*",
                "echo( .*)?",
                "find .*",
                "git branch.*",
                "git check-ignore.*",
                "git diff.*",
                "(GIT_PAGER=cat )?git log.*",
                "git ls-files.*",
                "git ls-tree .*",
                "git merge-base .*",
                "git rev-list .*",
                "git rev-parse .*",
                "git show.*",
                "git status.*",
                "grep .*",
                "head .*",
                "hostname",
                "jq( .*)?",
                "ls( .*)?",
                "make lint",
                "man .*",
                "mkdir -p .*",
                "pre-commit .*",
                "pwd",
                "read( .*)?",
                "readlink( .*)?",
                "sed .*",
                "sort( .*)?",
                "source .*",
                "tail .*",
                "tr .*",
                "tree( .*)?",
                "true",
                "type .*",
                "uniq .*",
                "wc .*",
                "which .*",
                "whoami",
                "xargs .*",
                "yamllint .*"
            ],
            "deniedCommands": [
                "ansible [^-].*",
                "ansible-console .*",
                "ansible-pull .*",
                "ansible-vault create .*",
                "ansible-vault decrypt .*",
                "ansible-vault edit .*",
                "ansible-vault encrypt .*",
                "ansible-vault rekey .*",
                "awk .*\\.env.*",
                "cat .*\\.env.*",
                "grep .*\\.env.*",
                "head .*\\.env.*",
                "sed .*\\.env.*",
                "tail .*\\.env.*",
                "find .*\\.env.*",
                "cat .*sops/age/keys\\.txt.*",
                "cat .*\\.agekey.*",
                "sops (decrypt|--decrypt|-d ).*",
                "cat .*\\.ssh/id_rsa.*",
                "cat .*\\.ssh/id_ed25519.*",
                "cat .*\\.ssh/id_ecdsa.*",
                "cat .*\\.ssh/id_dsa.*",
                "cat .*\\.ssh/.*_key[^.].*",
                "brew install .*",
                "chmod [0-7]{3,4} .*",
                "chmod -R .*",
                "chmod u\\+s .*",
                "chmod g\\+s .*",
                "chown .*",
                "crontab .*",
                "dd .*",
                "docker exec .*",
                "docker kill .*",
                "docker network rm .*",
                "docker rm .*",
                "docker rmi .*",
                "docker run .*",
                "docker stop .*",
                "docker system prune.*",
                "docker volume rm .*",
                "git add \\.",
                "git add -A.*",
                "git add --all.*",
                "kill .*",
                "killall .*",
                "kubectl .*",
                "npm install .*",
                "pip install .*",
                "pkill .*",
                "rm .*",
                "rmdir .*",
                "service .*",
                "ssh .*",
                "sudo .*",
                "systemctl .*",
                "trash .*"
            ]
        },
        "write": {
            "allowedPaths": [
                "~/projects/**",
                "~/repositories/**",
                "~/.dotfiles/**",
                "./**"
            ],
            "deniedPaths": [
                "/etc/**",
                "/usr/**",
                "/bin/**",
                "/sbin/**",
                "/System/**"
            ]
        },
        "grep": {
            "allowedPaths": [
                "~/projects/**",
                "~/repositories/**",
                "~/sources/**",
                "~/.dotfiles/**",
                "./**"
            ],
            "deniedPaths": [
                "/etc/**",
                "/usr/**",
                "/bin/**",
                "/sbin/**",
                "/System/**",
                "**/.env",
                "**/.env.*",
                "**/sops/age/keys.txt",
                "**/*.agekey",
                "**/.ssh/id_rsa",
                "**/.ssh/id_ed25519",
                "**/.ssh/id_ecdsa",
                "**/.ssh/id_dsa",
                "**/.ssh/*_key"
            ]
        },
        "glob": {
            "allowedPaths": [
                "~/projects/**",
                "~/repositories/**",
                "~/sources/**",
                "~/.dotfiles/**",
                "./**"
            ],
            "deniedPaths": [
                "/etc/**",
                "/usr/**",
                "/bin/**",
                "/sbin/**",
                "/System/**",
                "**/.env",
                "**/.env.*",
                "**/sops/age/keys.txt",
                "**/*.agekey",
                "**/.ssh/id_rsa",
                "**/.ssh/id_ed25519",
                "**/.ssh/id_ecdsa",
                "**/.ssh/id_dsa",
                "**/.ssh/*_key"
            ]
        },
        "subagent": {
            "availableAgents": [
                "default",
                "docs",
                "jira",
                "ansible",
                "datadog"
            ],
            "trustedAgents": [
                "default"
            ]
        },
        "web_fetch": {
            "trusted": [
                ".*docs\\.ansible\\.com.*",
                ".*ansible\\.readthedocs\\.io.*",
                ".*galaxy\\.ansible\\.com.*",
                ".*github\\.com.*",
                ".*pve\\.proxmox\\.com.*",
                ".*docs\\..*"
            ],
            "blocked": [
                ".*pastebin\\.com.*"
            ]
        },
        "read": {
            "deniedPaths": [
                "**/.env",
                "**/.env.*",
                "**/*.key",
                "**/*.pem",
                "**/credentials*",
                "**/.vault_pass*",
                "**/vault-password*",
                "**/sops/age/keys.txt",
                "**/*.agekey",
                "**/.ssh/id_rsa",
                "**/.ssh/id_ed25519",
                "**/.ssh/id_ecdsa",
                "**/.ssh/id_dsa",
                "**/.ssh/*_key"
            ]
        }
    },
    "includeMcpJson": true,
