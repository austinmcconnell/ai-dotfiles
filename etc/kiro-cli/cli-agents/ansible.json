                    "ansible-config view*",
                    "ansible-config validate*",
                    "ansible-doc *",
                    "ansible-galaxy *",
                    "ansible-inventory *",
                    "ansible-lint*",
                    "ansible-playbook * --check *",
                    "ansible-playbook * --check",
                    "ansible-playbook * --list-* *",
                    "ansible-playbook * --list-*",
                    "ansible-playbook * --syntax-check *",
                    "ansible-playbook * --syntax-check",
                    "ansible-vault view *",
                    "molecule cleanup*",
                    "molecule converge*",
                    "molecule create*",
                    "molecule destroy*",
                    "molecule exec*",
                    "molecule idempotence*",
                    "molecule init*",
                    "molecule list*",
                    "molecule login*",
                    "molecule matrix*",
                    "molecule reset*",
                    "molecule test*",
                    "molecule verify*",
                    "awk *",
                    "cat *",
                    "chmod +x *",
                    "command -v *",
                    "cruft *",
                    "dirname *",
                    "docker images*",
                    "docker inspect*",
                    "docker logs*",
                    "docker ps*",
                    "echo *",
                    "echo",
                    "find *",
                    "git branch*",
                    "git check-ignore*",
                    "git diff*",
                    "GIT_PAGER=cat git log*",
                    "git log*",
                    "git ls-files*",
                    "git ls-tree *",
                    "git merge-base *",
                    "git rev-list *",
                    "git rev-parse *",
                    "git show*",
                    "git status*",
                    "grep *",
                    "head *",
                    "hostname",
                    "jq *",
                    "jq",
                    "ls *",
                    "ls",
                    "make lint",
                    "man *",
                    "mkdir -p *",
                    "pre-commit *",
                    "pwd",
                    "read *",
                    "read",
                    "readlink *",
                    "readlink",
                    "sed *",
                    "sort *",
                    "sort",
                    "source *",
                    "tail *",
                    "tr *",
                    "tree *",
                    "tree",
                    "true",
                    "type *",
                    "uniq *",
                    "wc *",
                    "which *",
                    "whoami",
                    "xargs *",
                    "yamllint *"
