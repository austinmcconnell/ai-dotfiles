            },
            {
                "capability": "subagent",
                "match": [
                    "default"
                ],
                "effect": "allow"
            },
            {
                "capability": "fs_read",
                "effect": "allow"
            },
            {
                "capability": "subagent",
                "effect": "allow"
            },
            {
                "capability": "web_fetch",
                "effect": "allow"
            },
            {
                "capability": "web_search",
                "effect": "allow"
            },
            {
                "capability": "mcp",
