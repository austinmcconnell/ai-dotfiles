{
    "name": "docs",
    "description": "Documentation project specialist with mdBook expertise and best practices",
    "prompt": "file://./docs-prompt.md",
    "resources": [
        "file://~/.dotfiles/etc/ai/steering/documentation/**/*.md",
        "file://~/.dotfiles/etc/ai/steering/security/env-file-protection.md",
        "file://.kiro/steering/**/*.md",
        "file://AGENTS.md",
        "file://README.md",
        "file://SUMMARY.md",
        "file://book.toml",
        "skill://.kiro/skills/**/SKILL.md",
        "skill://~/.kiro/skills/documentation/**/SKILL.md",
        "skill://~/.kiro/skills/shared/**/SKILL.md",
        {
            "type": "knowledgeBase",
            "source": "file://~/projects/austinmcconnell/_research_",
            "name": "research",
            "description": "Structured research files covering product evaluations, technology comparisons, and technical investigations with cited sources and verification dates",
            "indexType": "best",
            "include": [
                "**/*.md"
            ],
            "exclude": [
                ".git/**"
            ],
            "autoUpdate": false
        },
        {
            "type": "knowledgeBase",
            "source": "file://~/projects/unite-us/sdohcc-screening-observations",
            "name": "sdohcc-screening-observations",
            "description": "SDOHCC screening observations mdBook documentation covering FHIR observation mappings, screening instruments, and clinical data standards",
            "indexType": "best",
            "include": [
                "**/*.md"
            ],
            "exclude": [
                ".git/**",
                "book/**",
                "scripts/**",
                "reports/**",
                ".kiro/**"
            ],
            "autoUpdate": true
        },
        {
            "type": "knowledgeBase",
            "source": "file://~/projects/austinmcconnell/_documentation_/automatic-ripping-machine",
            "name": "automatic-ripping-machine-docs",
            "description": "Multi-drive Automatic Ripping Machine build documentation covering drive selection, compute platform, NVMe storage, rack enclosure research, and component specifications. References ubiquiti-network-stack for IP address and VLAN assignments. References tiny-lab for rack slot, PDU port, and compute switch port assignments",
            "indexType": "best",
            "include": [
                "**/*.md"
            ],
            "exclude": [
                ".git/**",
                "book/**",
                "scripts/**",
                "reports/**"
            ],
            "autoUpdate": true
        },
        {
            "type": "knowledgeBase",
            "source": "file://~/projects/austinmcconnell/_documentation_/email-provider-selection",
            "name": "email-provider-selection-docs",
            "description": "Privacy-conscious email provider evaluation documentation covering provider comparisons (Fastmail, Mailbox.org, Migadu, StartMail), evaluation criteria, migration procedures, and architecture decisions. Isolated project with no shared infrastructure dependencies",
            "indexType": "best",
            "include": [
                "**/*.md"
            ],
            "exclude": [
                ".git/**",
                "book/**",
                "scripts/**",
                "reports/**"
            ],
            "autoUpdate": true
        },
        {
            "type": "knowledgeBase",
            "source": "file://~/projects/austinmcconnell/_documentation_/family-dashboard",
            "name": "family-dashboard-docs",
            "description": "Family wall calendar and chore management system documentation covering display hardware, software platform research (MagicMirror\u00b2, Home Assistant), kiosk software, mounting options, and component selection. References ubiquiti-network-stack for IP address and VLAN assignments",
            "indexType": "best",
            "include": [
                "**/*.md"
            ],
            "exclude": [
                ".git/**",
                "book/**",
                "scripts/**",
                "reports/**"
            ],
            "autoUpdate": true
        },
        {
            "type": "knowledgeBase",
            "source": "file://~/projects/austinmcconnell/_documentation_/gaming-media-pc",
            "name": "gaming-media-pc-docs",
            "description": "Gaming and media PC build documentation covering component selection, BIOS/Windows configuration, game streaming setup, and architecture decisions. Isolated project with no shared infrastructure dependencies",
            "indexType": "best",
            "include": [
                "**/*.md"
            ],
            "exclude": [
                ".git/**",
                "book/**",
                "scripts/**",
                "reports/**"
            ],
            "autoUpdate": true
        },
        {
            "type": "knowledgeBase",
            "source": "file://~/projects/austinmcconnell/_documentation_/home-assistant-server",
            "name": "home-assistant-server-docs",
            "description": "Dedicated Home Assistant server documentation covering HA Yellow (PoE) platform, Raspberry Pi CM5 compute module, HAOS installation, and component specifications. Operates independently from homelab. References ubiquiti-network-stack for IP address and VLAN assignments. References tiny-lab for rack slot, PDU port, and compute switch port assignments",
            "indexType": "best",
            "include": [
                "**/*.md"
            ],
            "exclude": [
                ".git/**",
                "book/**",
                "scripts/**",
                "reports/**"
            ],
            "autoUpdate": true
        },
        {
            "type": "knowledgeBase",
            "source": "file://~/projects/austinmcconnell/_documentation_/tiny-lab",
            "name": "tiny-lab-docs",
            "description": "Compact Proxmox homelab cluster documentation covering M920x Tiny hardware, ZFS storage, 2.5GbE networking, rack layout, PDU port assignments, compute rack switch port assignments, and cluster expansion decisions. Authoritative source for rack slot assignments, PDU ports, and compute switch ports. References ubiquiti-network-stack for IP addresses and VLANs",
            "indexType": "best",
            "include": [
                "**/*.md"
            ],
            "exclude": [
                ".git/**",
                "book/**",
                "scripts/**",
                "reports/**"
            ],
            "autoUpdate": true
        },
        {
            "type": "knowledgeBase",
            "source": "file://~/projects/austinmcconnell/_documentation_/truenas-server",
            "name": "truenas-server-docs",
            "description": "TrueNAS backup server build documentation covering ODROID H4+ hardware, ZFS mirror storage, network configuration, rackmount case, and component selection decisions. References tiny-lab for rack slot, PDU port, and compute switch port assignments. References ubiquiti-network-stack for IP address and VLAN assignments",
            "indexType": "best",
            "include": [
                "**/*.md"
            ],
            "exclude": [
                ".git/**",
                "book/**",
                "scripts/**",
                "reports/**"
            ],
            "autoUpdate": true
        },
        {
            "type": "knowledgeBase",
            "source": "file://~/projects/austinmcconnell/_documentation_/ubiquiti-network-stack",
            "name": "ubiquiti-network-docs",
            "description": "Ubiquiti UniFi home network documentation covering gateway, switches, access points, VLANs, firewall rules, VPN, WiFi, DNS ad blocking, and Pi-hole local DNS records. Authoritative source for all IP address assignments, VLAN definitions, DNS records, main switch port assignments, and gateway port assignments across all documentation repos",
            "indexType": "best",
            "include": [
                "**/*.md"
            ],
            "exclude": [
                ".git/**",
                "book/**",
                "scripts/**",
                "reports/**"
            ],
            "autoUpdate": true
        }
    ],
    "allowedTools": [
        "@engram/mem_capture_passive",
        "@engram/mem_compare",
        "@engram/mem_context",
        "@engram/mem_current_project",
        "@engram/mem_delete",
        "@engram/mem_doctor",
        "@engram/mem_get_observation",
        "@engram/mem_judge",
        "@engram/mem_save",
        "@engram/mem_save_prompt",
        "@engram/mem_search",
        "@engram/mem_session_end",
        "@engram/mem_session_start",
        "@engram/mem_session_summary",
        "@engram/mem_stats",
        "@engram/mem_suggest_topic_key",
        "@engram/mem_timeline",
        "@engram/mem_update",
        "code",
        "glob",
        "grep",
        "introspect",
        "knowledge",
        "read",
        "subagent",
        "todo",
        "web_fetch",
        "web_search"
    ],
    "tools": [
        "*"
    ],
    "hooks": [
        {
            "name": "agentSpawn-0",
            "trigger": "agentSpawn",
            "action": {
                "type": "command",
                "command": "~/.dotfiles/etc/kiro-cli/hooks/check-research-kb.sh docs"
            },
            "timeout": 5
        },
        {
            "name": "agentSpawn-1",
            "trigger": "agentSpawn",
            "action": {
                "type": "command",
                "command": "~/.dotfiles/etc/kiro-cli/hooks/recall-memory.sh"
            },
            "timeout": 5
        },
        {
            "name": "postToolUse-0",
            "trigger": "postToolUse",
            "matcher": "knowledge",
            "action": {
                "type": "command",
                "command": "~/.dotfiles/etc/kiro-cli/hooks/clear-research-kb-stale.sh docs"
            },
            "timeout": 5
        },
        {
            "name": "preToolUse-0",
            "trigger": "preToolUse",
            "matcher": "*",
            "action": {
                "type": "command",
                "command": "~/.dotfiles/etc/ai/hooks/block-env-files.sh"
            },
            "timeout": 5
        },
        {
            "name": "preToolUse-1",
            "trigger": "preToolUse",
            "matcher": "*",
            "action": {
                "type": "command",
                "command": "~/.dotfiles/etc/ai/hooks/block-sops-age-files.sh"
            },
            "timeout": 5
        },
        {
            "name": "preToolUse-2",
            "trigger": "preToolUse",
            "matcher": "*",
            "action": {
                "type": "command",
                "command": "~/.dotfiles/etc/ai/hooks/block-ssh-private-keys.sh"
            },
            "timeout": 5
        },
        {
            "name": "preToolUse-3",
            "trigger": "preToolUse",
            "matcher": "@engram/*",
            "action": {
                "type": "command",
                "command": "~/.dotfiles/etc/ai/hooks/block-memory-secrets.sh"
            },
            "timeout": 5
        }
    ],
    "toolsSettings": {
        "aws": {
            "allowedServices": []
        },
        "shell": {
            "allowedCommands": [
                "awk .*",
                "cat .*",
                "chmod \\+x .*",
                "command -v .*",
                "dirname .*",
                "echo( .*)?",
                "find .*",
                "git branch.*",
                "git check-ignore.*",
                "git diff.*",
                "(GIT_PAGER=cat )?git log.*",
                "git ls-files.*",
                "git ls-tree .*",
                "git merge-base .*",
                "git rev-list .*",
                "git rev-parse .*",
                "git show.*",
                "git status.*",
                "grep .*",
                "head .*",
                "hostname",
                "jq( .*)?",
                "ls( .*)?",
                "man .*",
                "mdbook .*",
                "mkdir -p .*",
                "pre-commit .*",
                "pwd",
                "read( .*)?",
                "readlink( .*)?",
                "sed .*",
                "sort( .*)?",
                "source .*",
                "tail .*",
                "tr .*",
                "tree( .*)?",
                "true",
                "type .*",
                "uniq .*",
                "wc .*",
                "which .*",
                "whoami",
                "xargs .*"
            ],
            "deniedCommands": [
                "awk .*\\.env.*",
                "cat .*\\.env.*",
                "grep .*\\.env.*",
                "head .*\\.env.*",
                "sed .*\\.env.*",
                "tail .*\\.env.*",
                "find .*\\.env.*",
                "cat .*sops/age/keys\\.txt.*",
                "cat .*\\.agekey.*",
                "sops (decrypt|--decrypt|-d ).*",
                "cat .*\\.ssh/id_rsa.*",
                "cat .*\\.ssh/id_ed25519.*",
                "cat .*\\.ssh/id_ecdsa.*",
                "cat .*\\.ssh/id_dsa.*",
                "cat .*\\.ssh/.*_key[^.].*",
                "rm .*",
                "sudo .*",
                "chmod [0-7]{3,4} .*",
                "chmod -R .*",
                "chmod u\\+s .*",
                "chmod g\\+s .*",
                "chown .*",
                "git add \\.",
                "git add -A.*",
                "git add --all.*",
                "docker .*",
                "kubectl .*"
            ]
        },
        "write": {
            "allowedPaths": [
                "~/projects/**",
                "~/repositories/**",
                "~/.dotfiles/**",
                "./**"
            ],
            "deniedPaths": [
                "/etc/**",
                "/usr/**",
                "/bin/**",
                "/sbin/**",
                "/System/**"
            ]
        },
        "grep": {
            "allowedPaths": [
                "~/projects/**",
                "~/repositories/**",
                "~/.dotfiles/**",
                "./**"
            ],
            "deniedPaths": [
                "/etc/**",
                "/usr/**",
                "/bin/**",
                "/sbin/**",
                "/System/**",
                "**/.env",
                "**/.env.*",
                "**/sops/age/keys.txt",
                "**/*.agekey",
                "**/.ssh/id_rsa",
                "**/.ssh/id_ed25519",
                "**/.ssh/id_ecdsa",
                "**/.ssh/id_dsa",
                "**/.ssh/*_key"
            ]
        },
        "glob": {
            "allowedPaths": [
                "~/projects/**",
                "~/repositories/**",
                "~/.dotfiles/**",
                "./**"
            ],
            "deniedPaths": [
                "/etc/**",
                "/usr/**",
                "/bin/**",
                "/sbin/**",
                "/System/**",
                "**/.env",
                "**/.env.*",
                "**/sops/age/keys.txt",
                "**/*.agekey",
                "**/.ssh/id_rsa",
                "**/.ssh/id_ed25519",
                "**/.ssh/id_ecdsa",
                "**/.ssh/id_dsa",
                "**/.ssh/*_key"
            ]
        },
        "subagent": {
            "availableAgents": [
                "default",
                "docs",
                "jira",
                "ansible",
                "datadog"
            ],
            "trustedAgents": [
                "default"
            ]
        },
        "web_fetch": {
            "trusted": [
                ".*rust-lang\\.io.*",
                ".*github\\.com.*",
                ".*mdbook.*",
                ".*adr\\.github\\.io.*",
                ".*readthedocs\\.io.*",
                ".*docs\\..*"
            ],
            "blocked": [
                ".*pastebin\\.com.*"
            ]
        },
        "read": {
            "deniedPaths": [
                "**/.env",
                "**/.env.*",
                "**/*.key",
                "**/*.pem",
                "**/credentials*",
                "**/sops/age/keys.txt",
                "**/*.agekey",
                "**/.ssh/id_rsa",
                "**/.ssh/id_ed25519",
                "**/.ssh/id_ecdsa",
                "**/.ssh/id_dsa",
                "**/.ssh/*_key"
            ]
        }
    },
    "includeMcpJson": true,
    "permissions": {
        "rules": [
            {
                "capability": "shell",
                "match": [
                    "awk *",
                    "cat *",
                    "chmod +x *",
                    "command -v *",
                    "dirname *",
                    "echo *",
                    "echo",
                    "find *",
                    "git branch*",
                    "git check-ignore*",
                    "git diff*",
                    "GIT_PAGER=cat git log*",
                    "git log*",
                    "git ls-files*",
                    "git ls-tree *",
                    "git merge-base *",
                    "git rev-list *",
                    "git rev-parse *",
                    "git show*",
                    "git status*",
                    "grep *",
                    "head *",
                    "hostname",
                    "jq *",
                    "jq",
                    "ls *",
                    "ls",
                    "man *",
                    "mdbook *",
                    "mkdir -p *",
                    "pre-commit *",
                    "pwd",
                    "read *",
                    "read",
                    "readlink *",
                    "readlink",
                    "sed *",
                    "sort *",
                    "sort",
                    "source *",
                    "tail *",
                    "tr *",
                    "tree *",
                    "tree",
                    "true",
                    "type *",
                    "uniq *",
                    "wc *",
                    "which *",
                    "whoami",
                    "xargs *"
                ],
                "effect": "allow"
            },
            {
                "capability": "shell",
                "match": [
                    "awk *.env*",
                    "cat *.env*",
                    "grep *.env*",
                    "head *.env*",
                    "sed *.env*",
                    "tail *.env*",
                    "find *.env*",
                    "cat *sops/age/keys.txt*",
                    "cat *.agekey*",
                    "sops decrypt*",
                    "sops --decrypt*",
                    "sops -d *",
                    "cat *.ssh/id_rsa*",
                    "cat *.ssh/id_ed25519*",
                    "cat *.ssh/id_ecdsa*",
                    "cat *.ssh/id_dsa*",
                    "cat *.ssh/*_key*",
                    "rm *",
                    "sudo *",
                    "chmod * *",
                    "chmod -R *",
                    "chmod u+s *",
                    "chmod g+s *",
                    "chown *",
                    "git add .",
                    "git add -A*",
                    "git add --all*",
                    "docker *",
                    "kubectl *"
                ],
                "exclude": [
                    "chmod +x *"
                ],
                "effect": "deny"
            },
            {
                "capability": "fs_read",
                "match": [
                    "**/.env",
                    "**/.env.*",
                    "**/*.key",
                    "**/*.pem",
                    "**/credentials*",
                    "**/sops/age/keys.txt",
                    "**/*.agekey",
                    "**/.ssh/id_rsa",
                    "**/.ssh/id_ed25519",
                    "**/.ssh/id_ecdsa",
                    "**/.ssh/id_dsa",
                    "**/.ssh/*_key"
                ],
                "effect": "deny"
            },
            {
                "capability": "fs_write",
                "match": [
                    "~/projects/**",
                    "~/repositories/**",
                    "~/.dotfiles/**",
                    "./**"
                ],
                "effect": "allow"
            },
            {
                "capability": "fs_write",
                "match": [
                    "/etc/**",
                    "/usr/**",
                    "/bin/**",
                    "/sbin/**",
                    "/System/**"
                ],
                "effect": "deny"
            },
            {
                "capability": "web_fetch",
                "match": [
                    "*rust-lang.io*",
                    "*github.com*",
                    "*mdbook*",
                    "*adr.github.io*",
                    "*readthedocs.io*",
                    "*docs.*"
                ],
                "effect": "allow"
            },
            {
                "capability": "web_fetch",
                "match": [
                    "*pastebin.com*"
                ],
                "effect": "deny"
            },
            {
                "capability": "subagent",
                "match": [
                    "default"
                ],
                "effect": "allow"
            },
            {
                "capability": "fs_read",
                "effect": "allow"
            },
            {
                "capability": "subagent",
                "effect": "allow"
            },
            {
                "capability": "web_fetch",
                "effect": "allow"
            },
            {
                "capability": "web_search",
                "effect": "allow"
            },
            {
                "capability": "mcp",
                "match": [
                    "engram/mem_capture_passive",
                    "engram/mem_compare",
                    "engram/mem_context",
                    "engram/mem_current_project",
                    "engram/mem_delete",
                    "engram/mem_doctor",
                    "engram/mem_get_observation",
                    "engram/mem_judge",
                    "engram/mem_save",
                    "engram/mem_save_prompt",
                    "engram/mem_search",
                    "engram/mem_session_end",
                    "engram/mem_session_start",
                    "engram/mem_session_summary",
                    "engram/mem_stats",
                    "engram/mem_suggest_topic_key",
                    "engram/mem_timeline",
                    "engram/mem_update"
                ],
                "effect": "allow"
            }
        ]
    }
}
