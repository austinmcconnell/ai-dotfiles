    },
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup|resume",
                "hooks": [
                    {
                        "type": "command",
                        "command": "AI_AGENT_NAME=claude-code $AI_DOTFILES_DIR/etc/ai/hooks/recall-memory.sh",
                        "timeout": 5
                    }
                ]
            },
            {
                "matcher": "startup|resume",
                "hooks": [
                    {
                        "type": "command",
                        "command": "$AI_DOTFILES_DIR/etc/ai/hooks/check-engram-hygiene.sh",
                        "timeout": 5
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "$AI_DOTFILES_DIR/etc/ai/hooks/block-env-files.sh",
                        "timeout": 5
                    }
                ]
            },
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "$AI_DOTFILES_DIR/etc/ai/hooks/block-sops-age-files.sh",
                        "timeout": 5
                    }
                ]
            },
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "$AI_DOTFILES_DIR/etc/ai/hooks/block-ssh-private-keys.sh",
                        "timeout": 5
                    }
                ]
            },
            {
                "matcher": "mcp__engram__.*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "$AI_DOTFILES_DIR/etc/ai/hooks/block-memory-secrets.sh",
                        "timeout": 5
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "$AI_DOTFILES_DIR/etc/ai/hooks/block-persona-shell-commands.sh",
                        "timeout": 5
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "AI_AGENT_NAME=claude-code $AI_DOTFILES_DIR/etc/ai/hooks/audit-shell-commands.sh",
                        "timeout": 10,
                        "async": true
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "$AI_DOTFILES_DIR/etc/ai/hooks/correction-capture.sh",
                        "timeout": 5
                    }
                ]
            }
        ]
    },
    "cleanupPeriodDays": 90,
    "showThinkingSummaries": true,
    "spinnerTipsEnabled": false,
    "theme": "dark"
}
